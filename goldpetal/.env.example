ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_mpin
ANGEL_API_KEY=your_api_key
ANGEL_TOTP_SECRET=your_totp_secret
# HTML desk (8501). Login is OFF unless DESK_PASSWORD is set. DESK_AUTH=true
# with no password does not block boot. IAP + bind 127.0.0.1 + Arm-live TOTP stay.
# DESK_AUTH=false
# DESK_PASSWORD=
# DESK_PASSWORD_HASH=salt:hex   # optional instead of DESK_PASSWORD
# DESK_TOTP_SECRET=BASE32SECRET # Google Authenticator for Arm live / restart / DRY_RUN=false
# DESK_TOTP_REQUIRED=true
# DESK_BIND_PUBLIC=false        # never bind 0.0.0.0 unless you mean it
DRY_RUN=true
# S16 builds the 1h bar in RAM. Do not archive every Angel tick.
# Signals still go to sqlite (leftover Exit / blotter). Desk LTP from last quote.
# Set STORE_TICKS=true only if you want ticks.db tape / bars / CSV.
STORE_TICKS=false
# Restart safety: restore RAM from DB, or close orphans
# POSITION_ON_RESTART=restore
# EOD flatten is S16 only (session book). S5/S8/S13/S18/… are delivery.
# EOD_FLATTEN_INTRADAY=true
# EOD_FLATTEN_MINUTES=5
ROLLOVER_DAYS=5
# Switch to next-month Gold Petal this many calendar days before front expiry.
# S13 flattens the front-month book on the last front session, then trades next month.
INTERVAL_MINUTES=30
# Market hours (IST), Mon-Fri only
MARKET_OPEN=09:00
MARKET_CLOSE=23:30
# Strategy thresholds
EXHAUSTION_PRICE_PCT=2.0
EXHAUSTION_NET_FOLD=3.0
LITTLE_PRICE_PCT=0.1
NET_SURGE_FOLD=2.0
# Portfolio — only trade when regime fits (paper until proven)
# Portfolio — slim paper set (others OFF to free RAM)
ENABLE_S1=false
ENABLE_S2=false
ENABLE_S3=false
ENABLE_S4=false
ENABLE_S5=false
ENABLE_S6=false
# S7_HOURLY is retired. Do not reuse ENABLE_S7.
# FLOW_BRAIN: live LTP + TBQ + TSQ pressure. New book. Paper only. Leave off
# until a tape shows after-charges edge. Not live. Not S7_HOURLY.
ENABLE_FLOW_BRAIN=false
# Gate pack for FLOW_BRAIN (research). Live/paper stay v1 until a tape pack
# beats v1 after charges. v1 | confirm10 | hold_opp | quality | desk
FLOW_BRAIN_GATE_PACK=v1
# FLOW_BRAIN_MIN_HOLD_SEC=20
# FLOW_BRAIN_COOLDOWN_SEC=15
# Next-move lab (states → 5s/30s/1m/5m after charges). Research only.
# python backtest_flow_brain_next.py --db data/ticks.db --lots 100 --fees
# FLOW_BRAIN_LEARN=false
# S8 ALIGN / zigzag — off live. Archive in docs/goldpetal_all_strategies.pdf
ENABLE_S8=false
ENABLE_S9=false
ENABLE_S10=false
# S11 pack ML is off the paper hot path. AMISE factory holds research ML.
# Re-enable only after you Approve a pack on the ML tab (still DRY_RUN=true).
ENABLE_S11=false
# S11_PACK_PATH=data/discover/packs/....json
# Retired from paper (not loaded): S12 30m HHHL, S14 wick, S15 nowick
ENABLE_S12=false
ENABLE_S14=false
ENABLE_S15=false
# S13 daily S16 — last 15m of this day. Hold the trend until opposite OR monthly rollover.
# C>prevC → HH+green LONG / LL+red SHORT. C<prevC → wick g0. C=prevC skip. FLIP.
# ROLLOVER_DAYS=5: flatten the front-month book on the last front session, then trade next month.
# Backtest: python backtest_s4_s13_daily_swing.py --from-angel --from 2026-08-02 --lots 100 --fees
ENABLE_S13=false
S13_ENTRY_MINUTES_BEFORE_CLOSE=15
S13_MIN_WICK_GAP=0
S13_ALLOW_LONG=true
S13_ALLOW_SHORT=true
# S16 1h HH/LL-or-wick. Wait for the 1h candle to finish. Intraday only.
# First fill is the first finished 1h of the session. Flatten at MARKET_CLOSE. Never overnight.
# C>prevC → HH+green LONG / LL+red SHORT (wicks ignored).
# C<prevC → wick g0 (lower>upper LONG, upper>lower SHORT). C=prevC skip. FLIP.
ENABLE_S16=true
S16_BAR_MINUTES=60
S16_MIN_WICK_GAP=0
# S18 1h OHLC+vol+yesterday pack overlay. Off live permanently.
ENABLE_S18=false
# S19 1h aligned body+close. Off live permanently.
ENABLE_S19=false
# Research: 3-candle body shrink fade (not a paper book). Two same-color bodies,
# second smaller and lower/higher, fade candle 3. No ENABLE. Do not rewrite S16.
# python backtest_body_shrink_fade.py --db data/ticks.db --lots 100 --fees --session
# BODY_SHRINK_FADE=false
# S20 1h fade HL. Not a live book. Leave off.
ENABLE_S20=false
# Overnight gap: read today near 23:15–23:30, BUY if next open looks up,
# SHORT if it looks down, CLOSE 09:00–09:05 next session. Mood-exempt.
# Off live permanently. Archive in docs/goldpetal_all_strategies.pdf.
ENABLE_OVERNIGHT_GAP=false
# OVERNIGHT_GAP_ENTRY_MINUTES_BEFORE_CLOSE=15
# OVERNIGHT_GAP_EXIT_MINUTES_AFTER_OPEN=5
# OVERNIGHT_GAP_LATE_MINUTES=45
# OVERNIGHT_GAP_BUY_PROB=0.58
# OVERNIGHT_GAP_SHORT_PROB=0.42
# OVERNIGHT_GAP_ALLOW_LONG=true
# OVERNIGHT_GAP_ALLOW_SHORT=true
FLATTEN_ON_BAD_REGIME=false
# Market regime was removed from the desk and engine. These flags are ignored.
# Books trade their formulas. AMISE may still read the tape to invent.
# Not a book. Do not ENABLE. Keep DRY_RUN=true.
MOOD_GATE=false
MOOD_FLATTEN=false
MOOD_FIT_MIN=0.40
# AMISE = Adaptive Market Intelligence & Strategy Engine.
# Desk tab /api/amise (observe). Run factory from the AMISE tab (Run factory)
# or: python3 amise.py --db data/ticks.db --lab --propose --fast
# Auto-repeat factory after you click Run factory once. Does not start on station boot.
# After Approve, that book stays in the closed-trade improve loop.
# Desk Run factory screens 3m…3h45 plus daily vs same-TF S16/S18
# (daily also vs S13), then the strong lab (3 folds, recipes, sklearn
# ranks, 2×/3× costs, holdout) plus an improve pass (hour gate, S18
# packs, AMISE same-slot mutations on that chair's timeframe).
# Skipping those gates does not make stronger books. Weekly: --full (same gates).
# This never sets DRY_RUN=false. Angel still needs Unlock + LIVE.
# There is no ENABLE_AMISE. S21+ ENABLE after you Approve.
AMISE_AUTO_LAB=true
AMISE_AUTO_LAB_HOURS=12
AMISE_FAST_LAB=true
ENABLE_S21=false
ENABLE_S22=false
ENABLE_S23=false
ENABLE_S24=false

# S2: 1-minute sum of buy1-5 vs sell1-5 qty, then same net-sign rules
S2_WINDOW_SECONDS=60
# S3 ML (train: python retrain_daily.py)
ML_BUY_PROB=0.58
ML_SHORT_PROB=0.42
ML_MIN_HOLD_SEC=30
ML_EVERY_N_TICKS=5
# S4 daily HH/LL swing is research-only (Angel/ticks pick was S13). Leave off.
S4_ENTRY_MINUTES_BEFORE_CLOSE=15
S4_ALLOW_LONG=true
S4_ALLOW_SHORT=true
# Overnight ML is research-only (weekly_s4.sh). Paper S4 does not exit next morning.
# S4_BUY_PROB=0.58
# S4_SHORT_PROB=0.42
# S4_EXIT_MINUTES_AFTER_OPEN=5
# S4_REASONING=true
# S4_REASONING_MIN_SCORE=0.45
# S4_REASONING_LOTS=100
# S4_MODEL_PATH=data/models/overnight_logreg.joblib
# S5 min-edge: only trade when expected move can beat costs
# Gold Petal: quote ₹/1g, lot=1g → 1 point ≈ ₹1 (TURNOVER_MULT=1)
# IGNORE_FEES=true (default): no Angel fees/tax in paper PnL or most strategy gates
IGNORE_FEES=true
# COVER_FEES only applies when IGNORE_FEES=false
COVER_FEES=false
# S5 still waits for a move that can beat real Angel costs
S5_COVER_FEES=true
EDGE_SAFETY_MULT=1.25
MIN_EDGE_POINTS=20
# Desk-wide self-learn scores for the Lab. AMISE invents; it does not skip
# a book's own formula. CLOSE is never gated.
EDGE_ML=false
EDGE_TARGET_WINRATE=0.70
EDGE_MIN_FLOOR=0.52
EDGE_ABOVE_BASE=0.08
EDGE_MIN_PROBA=0.70
EDGE_MIN_SAMPLES=20
EDGE_WARMUP_MAX=8
EDGE_RECENT_WINDOW=20
EDGE_REFIT_S=8
S5_EVERY_N_TICKS=5
S5_ATR_WINDOW=120
S5_IMBALANCE_RATIO=1.35
# S5 reasoning + weekly improve (./weekly_s5.sh → proposal)
# S5_REASONING=true
# S5_REASONING_MIN_SCORE=0.45
# S5_REASONING_LOTS=100
# S5_ML_MODEL_PATH=data/models/s5_minedge_ml.joblib
# S5_REQUIRE_ML=false
# S5_ML_MIN_PROBA=0.55
# S6: trade when expected move >= 30 points (no fee break-even gate)
S6_MIN_POINTS=30
S6_EVERY_N_TICKS=5
S6_ATR_WINDOW=120
S6_IMBALANCE_RATIO=1.35
# S8 ALIGN paper secondary (hist best: fat_tp_flip @ 50t — still behind legacy 30m)
ENABLE_S8=false
S8_LOGIC=align
S8_MODEL=fat_tp_flip
# S8_MODEL=flip_gate_2m   # alt: +₹6k hist on 2m
# S8_MODEL=hold_fat_flip  # stricter; often worse
# Decision TF (30m default for paper; minutes clears ticks)
S8_BAR_MINUTES=30
S8_BAR_TICKS=0
# S8_BAR_TICKS=50   # only if you want tick bars instead of minutes
S8_MIN_IMB_PCT=14
S8_USE_FEE_GATE=true
S8_FEE_BE_POINTS=50
S8_BOOK_FRAC_OF_NET=0.10
S8_BOOK_THR_CAP_PCT=0.002
S8_BREAK_MIN_BARS=2
S8_BREAK_MIN_ADVERSE=8
S8_BREAK_SKIP_IF_SUPPORTED=true
S8_BREAK_PRICE_MIN=1.5
S8_BREAK_PERSIST=1
S8_BREAK_NEED_BOTH=false
S8_PREFER_FAT_TP=true
S8_FLIP_MIN_BARS=2
S8_FLIP_MIN_ADVERSE=8
S8_FLIP_BLOCK_IN_PROFIT=true
S8_FLIP_PERSIST=1
S8_FLIP_NEED_WIDEN=false
S8_LOSS_LOCK_AFTER=5
S8_LOSS_LOCK_COOL_BARS=10
S8_REQUIRE_PULLBACK=false
# Reasoning models (entry / hold / exit) — override bundle S8_MODEL pieces
S8_ENTRY_MODEL=imb_sign_rise
# S8_ENTRY_MODEL=imb_sign       # NET sign only (no rising IMB)
# S8_ENTRY_MODEL=align_widen    # bias BULL/BEAR + book allow
S8_HOLD_MODEL=book_rise
# S8_HOLD_MODEL=book_or_support # also hold on dip/rally supported
# S8_HOLD_MODEL=off
S8_EXIT_MODEL=fat_tp_flip
# S8_EXIT_MODEL=book_drop       # mainly TBQ/TSQ drop exits
# S8_EXIT_MODEL=break_flip
# S8_EXIT_MODEL=hold_fat_flip
# Entry: NET>0 buy / NET<0 short, and abs(IMB)_now > abs(IMB)_prev
S8_REQUIRE_RISING_IMB=true
# Legacy: TBQ/TSQ rising as entry gate (OFF — those are hold/close only)
S8_REQUIRE_RISING_BOOK=false
# While supporting book still rises → HOLD; if lower vs prev → close
S8_HOLD_WHILE_BOOK_RISES=true
S8_HOLD_ON_SUPPORTED=false
S8_CLOSE_ON_BOOK_DROP=true
# Ignore tiny book noise (your -5/-18 TBQ chops); require >=0.25% drop vs prev
S8_BOOK_DROP_MIN_PCT=0.25
S8_BOOK_DROP_PERSIST=1
# Don't book_drop-exit while open profit >= this (ride trends)
S8_PROTECT_PROFIT_PTS=25
# Prefer hold on for trend days (H=off cuts winners):
# S8_HOLD_MODEL=book_rise
# Learned reasoning model (from: python3 learn_s8_align.py train …)
# S8_MODEL=learned
# S8_LEARNED_PRESET=data/s8_presets/learned_latest.json
# Weekly full ML pipeline (evolve_s8_ml.py / weekly_s8_nn.sh → Google Sheets + panel)
# Stages: instruction, human feedback, preference, reasoning heads, safety, tools
# Deep NN bake-off ON by default: shallow (64,32) vs deep (128,64,32,16) vs deeper
#   python3 deep_nn.py compare --db data/ticks.db --tf 30
#   python3 evolve_s8_ml.py train --deep --nn-arch deep
# S8_REQUIRE_NN=false   # only true if data/s8_nn/pipeline_latest.json safety_ok
# S8_NN_MODEL_PATH=data/models/s8_nn_mlp.joblib
# S8_NN_MIN_PROBA=0.55
# S8_NN_LAGS=3
# Multi-step reasoner (math/logic/science/planning) — s8_reasoner.py
# Three heads: ENTRY / HOLD / EXIT (see control panel Reasoning section)
S8_REASONING=true
S8_REASONING_MIN_SCORE=0.45
S8_REASONING_LOTS=100
# S8_ENTRY_MODEL / S8_HOLD_MODEL / S8_EXIT_MODEL still set rule flavour;
# reasoner is the gate that understands ongoing market + ML heads.
# At-scale improve: ./weekly_s8_nn.sh → walk-forward + curriculum.csv for Sheets
S8_PULLBACK_POINTS=8
S8_RESUME_POINTS=5
S8_EVERY_N_TICKS=1
S8_COOLDOWN_TICKS=1
S8_SL_MIN=20
S8_SL_MAX=55
S8_TP_MIN=35
S8_TP_MAX=80
S8_TP_POINTS=45
S8_SL_POINTS=35
S8_STALL_MIN_PROFIT=20
S8_STALL_BARS=3
S8_WEAKEN_PCT=20
S8_BEHAVIOUR_WINDOW=30
S8_RECORD_RETUNE=true
S8_SNAP_EVERY_N=25
# Legacy zigzag (old +₹16k path): S8_LOGIC=always  S8_BAR_MINUTES=30  S8_MODEL=
# S10: same MTF +₹42k row as its own strategy (does not touch S8 ALIGN)
ENABLE_S10=true
S10_BAR_MINUTES=30
S10_ENTRY_MODE=always
S10_MIN_IMB_PCT=10
S10_TP_POINTS=25
S10_SL_POINTS=20
S10_WEAKEN_PCT=10
S10_COOLDOWN_TICKS=0
# Hist MTF: python3 paper_sim_s8_align_mtf.py --db data/ticks.db --lots 100
# Hist tick-count bars 5t…60t: python3 paper_sim_s8_align_mtf.py --db data/ticks.db --lots 100 --only ticks
# ALIGN exit models sweep: python3 paper_sim_s8_align_models.py --db data/ticks.db --lots 100
# S9 state machine (defaults from 30m MFE/MAE study)
S9_BAR_MINUTES=30
S9_TP_POINTS=26
S9_SL_POINTS=16
S9_MIN_IMB_PCT=5
S9_REQUIRE_NET_SIGN=true
S9_ALLOW_SHORT=false
S9_BREAK_BARS=1
S9_JOURNAL=true
# Almost-equal for state '=': qty/vol 3–9% (default 5%); price 0.05% of LTP
S9_EQUAL_PCT=0.05
S9_EQUAL_PX_PCT=0.0005
# S9_EQUAL_PTS=5
# H/L × Volume gate (confirm H+V+/L+V+; veto H+V-). Off by default:
# VM compare @100 lots NO_HLV ≈+12k vs HLV_GATE ≈+0.4k on current sample.
S9_REQUIRE_HLV=false
S9_HLV_MODE=any
# 3-bar volume expansion confirm (INC_DEC + UP). Off until paper-sim beats BASE.
S9_REQUIRE_VOL_EXPANSION=false
S9_VOL_EXP_REQUIRE_UP=true
S9_VOL_EXP_REQUIRE_H_PLUS=false
# S9_VOL_TREND_LOOKBACK=2
# Flip-reverse on large opposing bar (close long → short / close short → long). Off by default.
S9_ENABLE_FLIP_REVERSE=false
S9_FLIP_LARGE_PTS=23
S9_FLIP_ON_STATE_BREAK=true
S9_FLIP_ON_NET_FLIP=true
S9_FLIP_ON_SL=false
S9_FLIP_ON_PROACTIVE=true
# S8-style trend align: BULL→long only, BEAR→short only
#   net  = sign(TBQ-TSQ) + IMB (S8)
#   dnet = sign(current NET − previous NET)
#   px   = close lookback trend
S9_REQUIRE_BIAS_ALIGN=false
S9_BIAS_MODE=net
S9_EXIT_ON_BIAS_FLIP=true
# Expected bar-range → adaptive TP/SL (default OFF until paper-sim beats FIXED 26/16)
S9_USE_RANGE_STOPS=false
# Bar ML entry filter (train: python3 train_s9_bar_ml.py). Default OFF until beats BIAS_NET.
S9_REQUIRE_ML_FILTER=false
# S9_ML_MODEL_PATH=data/models/s9_bar_ml.joblib
# S9_ML_MIN_PROBA=0.55
# S9_ML_LAGS=3
# S9_ML_ALLOW_IF_MISSING=true
# S9_RANGE_WINDOW=20
# S9_TP_RANGE_MULT=0.85
# S9_SL_RANGE_MULT=0.55
# S9_TP_MIN=12
# S9_TP_MAX=60
# S9_SL_MIN=10
# S9_SL_MAX=40
# S9_RANGE_FEE_BE=0
# S9_RANGE_MIN_RR=1.2
# S9_ENTER_LONG=B+S-P+,B+S+P+
# S9_CONTINUE_LONG=B+S-P+,B+S=P+,B=S-P+,B+S+P+,B+S-P=,B+S-P-
# Angel One MCX Gold Petal paper costs
BROKERAGE_PER_ORDER=20
BROKERAGE_PROMO=false
# BROKERAGE_PROMO=true   # first 30 days / ₹500 brokerage free
MCX_TXN_RATE=0.0000210
CTT_SELL_RATE=0.0001
SEBI_RATE=0.000001
STAMP_BUY_RATE=0.00002
GST_RATE=0.18
TAX_RATE=0.30
LOT_SIZE=1
# Paper tape / learner / fee gates. 1g contract stays LOT_SIZE=1. Live cap is LIVE_MAX_LOTS.
PAPER_LOTS=100
TURNOVER_MULT=1.0
