ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_mpin
ANGEL_API_KEY=your_api_key
ANGEL_TOTP_SECRET=your_totp_secret
DRY_RUN=true
ROLLOVER_DAYS=5
INTERVAL_MINUTES=30
# Market hours (IST), Mon-Fri only
MARKET_OPEN=09:00
MARKET_CLOSE=23:30
# Strategy thresholds
EXHAUSTION_PRICE_PCT=2.0
EXHAUSTION_NET_FOLD=3.0
LITTLE_PRICE_PCT=0.1
NET_SURGE_FOLD=2.0
# Portfolio — only trade when regime fits (paper until proven)
ENABLE_S1=true
ENABLE_S2=false
ENABLE_S3=true
ENABLE_S4=true
FLATTEN_ON_BAD_REGIME=true
# S3 ML (train: python retrain_daily.py)
ML_BUY_PROB=0.58
ML_SHORT_PROB=0.42
ML_MIN_HOLD_SEC=30
ML_EVERY_N_TICKS=5
# S4 overnight / delivery (full-day bullish-bearish → carry into next open)
S4_BUY_PROB=0.58
S4_SHORT_PROB=0.42
S4_ENTRY_MINUTES_BEFORE_CLOSE=15
S4_EXIT_MINUTES_AFTER_OPEN=5
# ML_MODEL_DIR=data/models
# ML_MODEL_PATH=data/models/logreg.joblib
