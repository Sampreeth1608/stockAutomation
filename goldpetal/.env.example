ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_mpin
ANGEL_API_KEY=your_api_key
ANGEL_TOTP_SECRET=your_totp_secret
DRY_RUN=true
ROLLOVER_DAYS=5
INTERVAL_MINUTES=30
# Market hours (IST), Mon-Fri only
MARKET_OPEN=09:00
MARKET_CLOSE=23:30
# Strategy thresholds
EXHAUSTION_PRICE_PCT=2.0
EXHAUSTION_NET_FOLD=3.0
LITTLE_PRICE_PCT=0.1
NET_SURGE_FOLD=2.0
# S3 ML (train first: export_full_ticks.py && train_models.py)
ML_BUY_PROB=0.58
ML_SHORT_PROB=0.42
ML_MIN_HOLD_SEC=30
ML_EVERY_N_TICKS=5
